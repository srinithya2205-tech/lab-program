# Backend configuration (copy to .env or set in your hosting dashboard)

# Comma-separated list of ORIGINS allowed to call the API from a browser.
# An origin is scheme + host (+ port) only — no path, no trailing slash.
# GitHub Pages serves your site at https://srinithya2205-tech.github.io/lab-program/
# but the browser's origin is just https://srinithya2205-tech.github.io
ALLOWED_ORIGINS=https://srinithya2205-tech.github.io,http://localhost:5173

# Port for local runs / platforms that inject it (Render, Railway, Fly set PORT automatically)
PORT=8000

# Number of uvicorn worker processes (1-2 is plenty for this app)
WEB_CONCURRENCY=2
